#!/usr/bin/env python3
"""Auto-rename the focused zellij tab from its panes.

Looks at the currently-focused tab and builds a name of the form:

    w<digits>[:<PROJECT>[-<slug>]]

- <digits>  concatenated digits of each pane whose cwd is a wofstack tree,
            in pane order (e.g. wofstack3 + wofstack5 + wofstack8 -> "358").
            Bare `wofstack` (no trailing number) maps to "1", matching the
            w1..w12 convention. The iproj / torch:project-status dashboard
            pane is skipped so it does not inject a spurious digit.
- <PROJECT> the project code of a running `iproj` pane — from its command line
            in the layout dump and/or the `CODE — Name` header on its screen.
- <slug>    1–3 word, ≤12-char abbreviation of the project name taken from the
            iproj pane screen (`torch:project-status` prints
            `{code} — {name}` at the top). Deterministic local slugify; no LLM.

Example: panes in wofstack3/5/8 plus `iproj EDX` showing
`EDX — Plan Skills` → `w358:EDX-plan-skills`.

Reads `zellij action dump-layout`. Pass a file path as $1 (or set
AUTONAME_DUMP) to parse a saved dump instead, and set AUTONAME_DRYRUN=1 to
print the computed name instead of renaming. Set AUTONAME_NO_SLUG=1 to skip
screen dump / slug (code only).
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

WOF_COMPONENT_RE = re.compile(r"^wofstack(\d*)$", re.IGNORECASE)
# Project codes look like EA, EDX, EBH, EU37-style prefixes — keep alnum only.
CODE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]{0,7}$")
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
# torch:project-status header: "EDX — Plan Skills" (em/en/ASCII dash).
HEADER_RE = re.compile(
    r"^([A-Za-z][A-Za-z0-9]{0,7})\s*[—–-]{1,3}\s+(.+)$"
)
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
MAX_SLUG_LEN = 12
STOP_WORDS = frozenset(
    {
        "a",
        "an",
        "and",
        "at",
        "by",
        "for",
        "from",
        "in",
        "of",
        "on",
        "or",
        "the",
        "to",
        "via",
        "vs",
        "with",
    }
)


def load_layout() -> str:
    src = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("AUTONAME_DUMP")
    if src:
        with open(src) as fh:
            return fh.read()
    return subprocess.run(
        ["zellij", "action", "dump-layout"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout


def focused_tab_block(lines: list[str]) -> list[str] | None:
    """Return the lines of the `tab ... focus=true { ... }` block, or None."""
    start = None
    for i, line in enumerate(lines):
        s = line.strip()
        if s.startswith("tab ") and "focus=true" in s and s.endswith("{"):
            start = i
            break
    if start is None:
        return None

    depth = 0
    block: list[str] = []
    for line in lines[start:]:
        block.append(line)
        depth += line.count("{") - line.count("}")
        if depth == 0:
            break
    return block


def focused_tab_name(block: list[str]) -> str | None:
    if not block:
        return None
    m = re.search(r'name="([^"]*)"', block[0])
    return m.group(1) if m else None


def wofstack_digit(cwd: str) -> str | None:
    """Return the wN digit for a cwd under a wofstack tree, or None."""
    # Prefer path components so worktrees like .../wofstack5/foo still match.
    for part in Path(cwd).parts:
        m = WOF_COMPONENT_RE.match(part)
        if m:
            return m.group(1) or "1"
    return None


def is_iproj_pane(line: str) -> bool:
    return "torch:project-status" in line


def code_from_iproj_command(line: str) -> str | None:
    toks = re.findall(r'"([^"]+)"', line)
    try:
        after = toks[toks.index("torch:project-status") + 1 :]
    except ValueError:
        after = []
    positional = [t for t in after if not t.startswith("-")]
    if positional and CODE_RE.match(positional[-1]):
        return positional[-1]
    return None


def collect(block: list[str]) -> tuple[list[str], str | None]:
    digits: list[str] = []
    code: str | None = None
    for line in block:
        s = line.strip()

        # Project code from the iproj / torch:project-status pane command line.
        if code is None and is_iproj_pane(s):
            code = code_from_iproj_command(s)
            # Never treat the dashboard's cwd as a work digit.
            continue

        if not s.startswith("pane"):
            continue
        m = re.search(r'cwd="([^"]+)"', s)
        if not m:
            continue
        dig = wofstack_digit(m.group(1))
        if dig is not None and dig not in digits:
            digits.append(dig)

    return digits, code


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text)


def slugify_project_name(name: str) -> str | None:
    """Turn a project title into a ≤12-char hyphenated lowercase slug."""
    if not name:
        return None
    words = re.findall(r"[a-z0-9]+", name.lower())
    if not words:
        return None
    kept = [w for w in words if w not in STOP_WORDS and len(w) > 1]
    if not kept:
        kept = words

    chosen: list[str] = []
    for w in kept[:3]:
        trial = "-".join(chosen + [w])
        if len(trial) > MAX_SLUG_LEN:
            if not chosen:
                cut = w[:MAX_SLUG_LEN].strip("-")
                return cut if cut and len(cut) >= 2 and SLUG_RE.match(cut) else None
            break
        chosen.append(w)

    slug = "-".join(chosen)
    if not slug or len(slug) < 2 or not SLUG_RE.match(slug):
        return None
    return slug


def parse_iproj_header(
    screen: str, expected_code: str | None = None
) -> tuple[str, str] | None:
    """Parse `CODE — Project Name` from a torch:project-status screen dump."""
    text = strip_ansi(screen)
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    for i, line in enumerate(lines[:40]):
        m = HEADER_RE.match(line)
        if not m:
            continue
        code, name = m.group(1), m.group(2).strip()
        if not CODE_RE.match(code) or not name:
            continue
        if expected_code and code.upper() != expected_code.upper():
            continue
        # Prefer a true project-status frame (header near Schedule / tasks).
        window = "\n".join(lines[i : i + 8])
        looks_like_status = (
            "Schedule:" in window
            or "No tasks in this project" in window
            or "Refreshing every" in text
            or "Blocked by project" in window
            or re.search(r"\[(?:Released|Merged|Closed|Blocked)", window) is not None
            or re.search(r"^\[([A-Z]{1,4}\d*)\]", window, re.M) is not None
        )
        if looks_like_status or expected_code:
            return code, name
    return None


def list_panes_json() -> list[dict]:
    try:
        result = subprocess.run(
            ["zellij", "action", "list-panes", "-j", "-t"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, subprocess.CalledProcessError):
        return []
    try:
        data = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def dump_pane_screen(pane_id: int | str) -> str:
    try:
        result = subprocess.run(
            ["zellij", "action", "dump-screen", "-p", str(pane_id)],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    return result.stdout or ""


def project_from_iproj_screen(
    tab_name: str | None, expected_code: str | None
) -> tuple[str | None, str | None]:
    """Dump focused-tab panes and extract (code, slug) from an iproj screen.

    Skipped when AUTONAME_NO_SLUG is set, or when parsing a saved layout dump
    (no live zellij session to dump).
    """
    if os.environ.get("AUTONAME_NO_SLUG") or os.environ.get("AUTONAME_NO_GROK"):
        return expected_code, None
    # Offline dump-only mode: no live panes.
    if len(sys.argv) > 1 or os.environ.get("AUTONAME_DUMP"):
        return expected_code, None

    panes = list_panes_json()
    if not panes:
        return expected_code, None

    candidates: list[dict] = []
    for pane in panes:
        if pane.get("is_plugin"):
            continue
        if tab_name is not None and pane.get("tab_name") != tab_name:
            continue
        candidates.append(pane)

    # Prefer non-focused panes first — the user is usually not sitting in iproj.
    candidates.sort(key=lambda p: (bool(p.get("is_focused")), p.get("id", 0)))

    for pane in candidates:
        pid = pane.get("id")
        if pid is None:
            continue
        screen = dump_pane_screen(pid)
        if not screen.strip():
            continue
        parsed = parse_iproj_header(screen, expected_code=expected_code)
        if parsed is None and expected_code is None:
            # Last resort: any project-status header on this tab.
            parsed = parse_iproj_header(screen, expected_code=None)
        if parsed is None:
            continue
        code, name = parsed
        slug = slugify_project_name(name)
        return code, slug

    return expected_code, None


def build_name(digits: list[str], code: str | None, slug: str | None) -> str:
    parts_left = ""
    if digits:
        parts_left = "w" + "".join(digits)

    right = ""
    if code:
        right = f"{code}-{slug}" if slug else code

    if parts_left and right:
        return f"{parts_left}:{right}"
    return parts_left or right


def main() -> None:
    lines = load_layout().splitlines()
    block = focused_tab_block(lines)
    if block is None:
        return

    digits, code = collect(block)
    tab_name = focused_tab_name(block)
    code, slug = project_from_iproj_screen(tab_name, code)

    name = build_name(digits, code, slug)
    if not name:
        return

    if os.environ.get("AUTONAME_DRYRUN"):
        print(name)
        return
    subprocess.run(["zellij", "action", "rename-tab", name], check=False)


if __name__ == "__main__":
    main()
